<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ProfileActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:drawableLeft="@drawable/user_01"
        android:drawablePadding="10dp"
        android:text="Profile"
        android:textSize="28sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/backimage"
        android:layout_width="34dp"
        android:layout_height="29dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        android:src="@drawable/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/entername"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/edittextshape"
        android:elevation="16dp"
        android:ems="10"
        android:hint="Enter Your Name"
        android:outlineSpotShadowColor="#2ECCB8"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <EditText
        android:id="@+id/enteradress"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/edittextshape"
        android:elevation="16dp"
        android:ems="10"
        android:hint="Enter Your Address"
        android:outlineSpotShadowColor="#2ECCB8"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/entername" />

    <EditText
        android:id="@+id/entergstbil"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/edittextshape"
        android:elevation="16dp"
        android:ems="10"
        android:hint="Enter GST number"
        android:outlineSpotShadowColor="#2ECCB8"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enteradress" />

    <TextView
        android:id="@+id/selectimage"
        android:layout_width="252dp"
        android:layout_height="55dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/edittextshape"
        android:drawableRight="@drawable/plus_circle"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:outlineSpotShadowColor="#2ECCB8"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="GST Bill"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/entergstbil" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView6"
        android:layout_width="210dp"
        android:layout_height="185dp"
        android:layout_marginTop="12dp"
        android:elevation="16dp"
        android:outlineSpotShadowColor="#2ECCB8"
        app:cardCornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/selectimage"
        app:layout_constraintTop_toBottomOf="@+id/selectimage">

        <ImageView
            android:id="@+id/selectedimage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/heart" />

    </androidx.cardview.widget.CardView>

    <EditText
        android:id="@+id/contactnumber"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/edittextshape"
        android:elevation="16dp"
        android:ems="10"
        android:hint="Enter ontact N0."
        android:outlineSpotShadowColor="#2ECCB8"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView6" />/

    <EditText
        android:id="@+id/emailaddress"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/edittextshape"
        android:elevation="16dp"
        android:ems="10"
        android:hint="Enter Email Address"
        android:outlineSpotShadowColor="#2ECCB8"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contactnumber" />
</androidx.constraintlayout.widget.ConstraintLayout>